<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island — настройки" Width="560" Height="670"
        MinWidth="480" MinHeight="460" WindowStartupLocation="CenterScreen"
        Background="#151518" Foreground="#F2F2F7" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEAEB8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="#303036"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#25252B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#494952"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,22,24,18">
                <TextBlock Text="Остров, который не мешает" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource Caption}" Text="Настройки положения и глобальных горячих клавиш" Margin="0,0,0,22"/>
                <TextBlock Style="{StaticResource Heading}" Text="Режим"/>
                <RadioButton x:Name="FloatingRadio" Foreground="White" Content="Поверх окон — без изменения высоты экрана" GroupName="Mode" Margin="0,0,0,10"/>
                <RadioButton x:Name="StripRadio" Foreground="White" Content="Отдельная полоса сверху" GroupName="Mode" Margin="0,0,0,8"
                             Checked="Mode_Changed" Unchecked="Mode_Changed"/>
                <TextBlock Style="{StaticResource Caption}" Text="В режиме полосы развёрнутые окна располагаются ниже острова. При скрытии или переносе полоса освобождается."/>
                <Grid x:Name="StripControls" Margin="0,10,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                    <Slider x:Name="HeightSlider" Minimum="46" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding ElementName=HeightSlider, Path=Value, StringFormat={}{0:0} px}"/>
                </Grid>
                <TextBlock Style="{StaticResource Heading}" Text="Сохранённое положение"/>
                <TextBlock Style="{StaticResource Caption}" Text="Хоткей переключает остров между верхним центром и этим местом. Каждое нажатие — одно переключение." Margin="0,0,0,10"/>
                <WrapPanel Margin="0,0,0,12">
                    <Button Content="Справа ниже вкладок" Click="RightPreset_Click" Margin="0,0,6,6"/>
                    <Button Content="Слева ниже вкладок" Click="LeftPreset_Click" Margin="0,0,6,6"/>
                    <Button Content="Ниже по центру" Click="CenterPreset_Click" Margin="0,0,0,6"/>
                </WrapPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Горизонталь"/>
                    <Slider x:Name="XSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding ElementName=XSlider, Path=Value, StringFormat={}{0:0}%}"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Вертикаль"/>
                    <Slider x:Name="YSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding ElementName=YSlider, Path=Value, StringFormat={}{0:0}%}"/>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="0% — левый или верхний край, 100% — правый или нижний. Положение ограничено главным экраном, чтобы раскрытый плеер помещался целиком."/>
                <TextBlock Style="{StaticResource Caption}" Text="Также можно зажать Ctrl и перетащить остров мышкой — место сохранится автоматически." Margin="0,8,0,22"/>
                <TextBlock Style="{StaticResource Heading}" Text="Горячие клавиши"/>
                <TextBlock Style="{StaticResource Caption}" Text="Нажми на поле и введи новое сочетание с Ctrl, Alt или Win. Клавиши работают из других приложений." Margin="0,0,0,12"/>
                <TextBlock Text="Центр ↔ сохранённое положение" Margin="0,0,0,6"/>
                <TextBox x:Name="MoveKeyBox" PreviewKeyDown="Shortcut_PreviewKeyDown" Margin="0,0,0,12"/>
                <TextBlock Text="Полностью скрыть ↔ показать" Margin="0,0,0,6"/>
                <TextBox x:Name="HideKeyBox" PreviewKeyDown="Shortcut_PreviewKeyDown" Margin="0,0,0,12"/>
                <TextBlock Style="{StaticResource Caption}" Text="Вернуть скрытый остров можно и нажатием на его значок в трее. Музыка и таймер продолжают работать."/>
                <TextBlock x:Name="ErrorText" Foreground="#FF9E92" Visibility="Collapsed" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#1E1E23" Padding="24,14">
            <Grid>
                <Button Content="По умолчанию" HorizontalAlignment="Left" Click="Defaults_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="Сохранить" Background="#276FD7" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
