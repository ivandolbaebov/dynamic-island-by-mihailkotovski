<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island" Width="680" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True"
        FontFamily="./Fonts/#SF Pro Text, SF Pro Text, Segoe UI Variable Display, Segoe UI" Foreground="White">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="Green" Color="#30D158"/>
        <SolidColorBrush x:Key="Red" Color="#FF453A"/>

        <LinearGradientBrush x:Key="ArtPlaceholder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#48484A" Offset="0"/>
            <GradientStop Color="#1C1C1E" Offset="1"/>
        </LinearGradientBrush>

        <!-- round media button: soft hover disc + squish on press -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Squish"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Disc" Fill="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleX" To="0.82" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleY" To="0.82" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Squish" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="5"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" CornerRadius="12" Background="#00FFFFFF" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small filled pill: timer presets, and the start button with its own background -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="14" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Shine" CornerRadius="14" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shine" Property="Opacity" Value="0.22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Width="620" Height="270" Margin="0,8,0,0" Opacity="0"
          HorizontalAlignment="Center" VerticalAlignment="Top"
          MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseLeftButtonUp="Root_MouseLeftButtonUp"
          MouseRightButtonUp="Root_MouseRightButtonUp" MouseWheel="Root_MouseWheel"
          PreviewMouseLeftButtonDown="Move_PreviewMouseLeftButtonDown"
          PreviewMouseLeftButtonUp="Move_PreviewMouseLeftButtonUp"
          PreviewMouseMove="Move_PreviewMouseMove" LostMouseCapture="Move_LostMouseCapture">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootMove"/>
        </Grid.RenderTransform>

        <!-- a second activity (the timer, while the pill is busy with something else) splits off into its own
             bubble: it sits behind the pill's right end and slides out from under it. It answers the pointer
             on its own, growing away from the pill so the gap between them holds -->
        <Border x:Name="Bubble" Width="78" Height="34" CornerRadius="17" Visibility="Collapsed"
                Background="Black" BorderBrush="#20FFFFFF" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0,0"
                MouseEnter="Bubble_MouseEnter" MouseLeave="Bubble_MouseLeave"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown" MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale"/>
                    <TranslateTransform x:Name="BubbleMove"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="BubbleBody">
                <local:Ring x:Name="BubbleRing" Width="16" Height="16" Stroke="{StaticResource Orange}"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <local:Digits x:Name="BubbleText" Text="25:00" FontSize="12.5" FontWeight="SemiBold"
                              Foreground="{StaticResource Orange}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- the pill and everything in it: one piece under the pointer, scaled from its top centre -->
        <Grid x:Name="Island" RenderTransformOrigin="0.5,0"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="IslandScale"/>
            </Grid.RenderTransform>

            <Border x:Name="Shadow" Background="Black" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="38" ShadowDepth="10" Direction="270" Opacity="0.6" Color="Black"/>
                </Border.Effect>
            </Border>

            <Border x:Name="Pill" Background="Black" BorderBrush="#20FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Top"/>

            <!-- every state lives here at its final size; the pill clip reveals it -->
            <Grid x:Name="Host">

                <!-- idle: clock -->
                <Grid x:Name="IdleView" Width="118" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock x:Name="IdleClock" Text="00:00" FontSize="13.5" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- compact now-playing -->
                <Grid x:Name="MediaView" Width="210" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Width="22" Height="22" HorizontalAlignment="Left" Margin="7,0,0,0">
                        <Border CornerRadius="6" Background="{StaticResource ArtPlaceholder}">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="11" Foreground="{StaticResource Dim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ArtSmall" CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <!-- synced lyric line: long lines scroll sideways, both edges fade into the pill -->
                    <Canvas x:Name="LyricBox" Height="34" Margin="36,0,41,0"
                            Background="Transparent" ClipToBounds="True" IsHitTestVisible="False"
                            SizeChanged="LyricBox_SizeChanged">
                        <Canvas.OpacityMask>
                            <LinearGradientBrush x:Name="LyricMask" MappingMode="Absolute" StartPoint="0,0" EndPoint="133,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop x:Name="LyricMaskIn" Color="Black" Offset="0.06"/>
                                <GradientStop x:Name="LyricMaskOut" Color="Black" Offset="0.94"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Canvas.OpacityMask>
                        <TextBlock x:Name="LyricA" FontSize="12" FontWeight="Medium" Opacity="0"
                                   TextOptions.TextHintingMode="Animated">
                            <TextBlock.RenderTransform>
                                <TranslateTransform/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="LyricB" FontSize="12" FontWeight="Medium" Opacity="0"
                                   TextOptions.TextHintingMode="Animated">
                            <TextBlock.RenderTransform>
                                <TranslateTransform/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                    <local:Equalizer x:Name="EqSmall" Bars="5" Width="21" Height="16"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                </Grid>

                <!-- compact countdown -->
                <Grid x:Name="TimerView" Width="132" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Ring x:Name="TimerRing" Width="18" Height="18" Stroke="{StaticResource Orange}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <local:Digits x:Name="TimerText" Text="25:00" FontSize="13.5" FontWeight="SemiBold"
                                  Foreground="{StaticResource Orange}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                </Grid>

                <!-- volume HUD -->
                <Grid x:Name="VolumeView" Width="250" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="162"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="VolIcon" FontFamily="{StaticResource Icons}" Text="&#xE995;" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Height="5" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="#33FFFFFF"/>
                        <Border x:Name="VolFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="VolText" Grid.Column="2" Text="0" FontSize="12.5" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- charger plugged in -->
                <Grid x:Name="ChargeView" Width="230" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock Text="Зарядка" FontSize="13" FontWeight="SemiBold" Margin="16,0,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <TextBlock x:Name="ChargeText" Text="100%" FontSize="13" FontWeight="SemiBold" Foreground="#30D158"
                                   VerticalAlignment="Center"/>
                        <Grid Width="27" Height="13" Margin="7,0,0,0" VerticalAlignment="Center">
                            <Border Width="24" HorizontalAlignment="Left" CornerRadius="4" BorderBrush="#66FFFFFF" BorderThickness="1"/>
                            <Border x:Name="ChargeFill" Width="20" Height="9" Margin="2,0,0,0" CornerRadius="2.5" Background="#30D158"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Border Width="2" Height="5" CornerRadius="0,1,1,0" Background="#66FFFFFF"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- track changed -->
                <Grid x:Name="ToastView" Width="340" Height="68" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Width="44" Height="44" HorizontalAlignment="Left" Margin="12,0,0,0">
                        <Border CornerRadius="11" Background="{StaticResource ArtPlaceholder}">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="19" Foreground="{StaticResource Dim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="ArtToast" CornerRadius="11" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel Margin="68,0,58,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ToastArtist" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <local:Equalizer x:Name="EqToast" Bars="5" Width="23" Height="20"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/>
                </Grid>

                <!-- one-off notice: audio device, network, timer finished -->
                <Grid x:Name="NoticeView" Width="320" Height="64" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border Width="40" Height="40" CornerRadius="11" Background="#1FFFFFFF" HorizontalAlignment="Left" Margin="12,0,0,0">
                        <TextBlock x:Name="NoticeIcon" FontFamily="{StaticResource Icons}" FontSize="19"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="NoticePulse"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="64,0,22,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NoticeTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NoticeText" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- expanded player -->
                <Grid x:Name="MediaBigView" Width="380" Height="176" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <local:Aura x:Name="Glow" IsHitTestVisible="False"/>

                    <Grid Height="64" Margin="20,20,22,0" VerticalAlignment="Top">
                        <Grid Width="64" Height="64" HorizontalAlignment="Left">
                            <Border CornerRadius="16" Background="{StaticResource ArtPlaceholder}">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="26" Foreground="{StaticResource Dim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ArtBig" CornerRadius="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Margin="78,0,52,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleBig" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistBig" FontSize="13" Foreground="{StaticResource Dim}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <local:Equalizer x:Name="EqBig" Bars="8" Width="38" Height="26"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Height="20" Margin="20,97,20,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PosText" Text="0:00" FontSize="11" Foreground="{StaticResource Dim}"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                        <Border x:Name="SeekArea" Grid.Column="1" Background="Transparent" Cursor="Hand"
                                MouseLeftButtonDown="Seek_MouseLeftButtonDown" MouseMove="Seek_MouseMove"
                                MouseLeftButtonUp="Seek_MouseLeftButtonUp" LostMouseCapture="Seek_LostMouseCapture">
                            <Grid x:Name="SeekBar" Height="6" VerticalAlignment="Center">
                                <Border x:Name="SeekBack" CornerRadius="3" Background="#33FFFFFF"/>
                                <Border x:Name="SeekFill" CornerRadius="3" Background="White" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="RemText" Grid.Column="2" Text="-0:00" FontSize="11" Foreground="{StaticResource Dim}"
                                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Style="{StaticResource IconButton}" Click="Prev_Click">
                            <Path Data="M22,1 L12,7.5 L22,14 Z M11,1 L1,7.5 L11,14 Z" Fill="White" Stroke="White"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="52" Height="52" Margin="16,0" Click="Play_Click">
                            <Grid>
                                <Path x:Name="PlayIcon" Data="M2,1 L16,10 L2,19 Z" Fill="White" Stroke="White" Margin="4,0,0,0"
                                      StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                <Path x:Name="PauseIcon" Data="M1,1 H6 V19 H1 Z M12,1 H17 V19 H12 Z" Fill="White" Stroke="White"
                                      StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Next_Click">
                            <Path Data="M1,1 L11,7.5 L1,14 Z M12,1 L22,7.5 L12,14 Z" Fill="White" Stroke="White"
                                  StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Button>
                    </StackPanel>

                    <!-- charge of the Bluetooth headphones the sound goes to, level with the buttons -->
                    <StackPanel x:Name="PlayerHeadset" Orientation="Horizontal" Height="52" Margin="0,0,20,8"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <TextBlock x:Name="PlayerHeadsetIcon" FontFamily="{StaticResource Icons}" Text="&#xE7F6;" FontSize="13"
                                   Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PlayerHeadsetText" FontSize="11" Foreground="{StaticResource Dim}" Margin="5,0,0,0"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- expanded, nothing playing -->
                <Grid x:Name="IdleBigView" Width="320" Height="124" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="26,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="BigClock" Text="00:00" FontSize="46" FontWeight="SemiBold"
                                   FontFamily="./Fonts/#SF Pro Display, SF Pro Display, Segoe UI Variable Display, Segoe UI"
                                   Typography.NumeralAlignment="Tabular"/>
                        <TextBlock x:Name="BigDate" FontSize="13" Foreground="{StaticResource Dim}" Margin="2,-4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="InfoVolIcon" FontFamily="{StaticResource Icons}" Text="&#xE995;" FontSize="15"
                                       Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoVol" Text="—" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="InfoHeadsetRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="InfoHeadsetIcon" FontFamily="{StaticResource Icons}" Text="&#xE7F6;" FontSize="15"
                                       Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoHeadset" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="InfoBatRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"
                                    Visibility="Collapsed">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE83F;" FontSize="15"
                                       Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InfoBat" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- expanded countdown -->
                <Grid x:Name="TimerBigView" Width="330" Height="92" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Style="{StaticResource IconButton}" Width="50" Height="50" Click="TimerToggle_Click">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="#40FF9F0A"/>
                                <Path x:Name="TimerPauseIcon" Data="M1,1 H5 V15 H1 Z M10,1 H14 V15 H10 Z"
                                      Fill="{StaticResource Orange}" Stroke="{StaticResource Orange}"
                                      StrokeThickness="2" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="TimerPlayIcon" Data="M2,1 L13,8 L2,15 Z" Margin="3,0,0,0" Visibility="Collapsed"
                                      Fill="{StaticResource Orange}" Stroke="{StaticResource Orange}"
                                      StrokeThickness="2" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="50" Height="50" Margin="10,0,0,0" Click="TimerCancel_Click">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="#2EFFFFFF"/>
                                <Path Data="M1,1 L13,13 M13,1 L1,13" Stroke="White" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,26,2">
                        <TextBlock x:Name="BigTimerLabel" Text="Таймер" FontSize="12" Foreground="{StaticResource Orange}"
                                   Opacity="0.8" HorizontalAlignment="Right"/>
                        <local:Digits x:Name="BigTimer" Text="25:00" FontSize="40" FontWeight="SemiBold"
                                      FontFamily="./Fonts/#SF Pro Display, SF Pro Display, Segoe UI Variable Display, Segoe UI"
                                      Foreground="{StaticResource Orange}"
                                      HorizontalAlignment="Right" Margin="0,-4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- new countdown: −/+, a preset or the mouse wheel sets the minutes -->
                <Grid x:Name="TimerSetView" Width="300" Height="190" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="14,14,14,0">
                        <TextBlock Text="ТАЙМЕР" FontSize="10.5" FontWeight="SemiBold" Foreground="#66FFFFFF"
                                   Margin="8,0,0,0"/>
                        <Grid Height="56">
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="TimerLess_Click">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE738;" FontSize="15"/>
                            </Button>
                            <local:Digits x:Name="SetupText" Text="25:00" FontSize="38" FontWeight="SemiBold"
                                          FontFamily="./Fonts/#SF Pro Display, SF Pro Display, Segoe UI Variable Display, Segoe UI"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="TimerMore_Click">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE710;" FontSize="15"/>
                            </Button>
                        </Grid>
                        <UniformGrid Rows="1" Margin="0,4,0,0">
                            <Button Style="{StaticResource ChipButton}" Tag="5" Content="5 мин" Click="TimerPreset_Click"/>
                            <Button Style="{StaticResource ChipButton}" Tag="10" Content="10 мин" Click="TimerPreset_Click"/>
                            <Button Style="{StaticResource ChipButton}" Tag="15" Content="15 мин" Click="TimerPreset_Click"/>
                            <Button Style="{StaticResource ChipButton}" Tag="25" Content="25 мин" Click="TimerPreset_Click"/>
                            <Button Style="{StaticResource ChipButton}" Tag="45" Content="45 мин" Click="TimerPreset_Click"/>
                        </UniformGrid>
                        <Button Style="{StaticResource ChipButton}" Height="36" Margin="2,10,2,0" Content="Запустить"
                                Background="{StaticResource Orange}" Foreground="Black" FontSize="13.5" FontWeight="SemiBold"
                                Click="TimerStart_Click"/>
                    </StackPanel>
                </Grid>

                <!-- right-click menu -->
                <Grid x:Name="MenuView" Width="280" Height="208" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Margin="10,14,10,0">
                        <TextBlock Text="DYNAMIC ISLAND" FontSize="10.5" FontWeight="SemiBold" Foreground="#66FFFFFF"
                                   Margin="12,0,0,6"/>
                        <Button Style="{StaticResource RowButton}" Click="TimerRow_Click">
                            <Grid>
                                <TextBlock Text="Таймер" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <local:Digits x:Name="MenuTimer" Foreground="{StaticResource Orange}" VerticalAlignment="Center"/>
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76C;" FontSize="10"
                                               Foreground="{StaticResource Dim}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="Autostart_Click">
                            <Grid>
                                <TextBlock Text="Запускать с Windows" VerticalAlignment="Center"/>
                                <Border x:Name="SwitchTrack" Width="38" Height="22" CornerRadius="11" HorizontalAlignment="Right">
                                    <Ellipse Width="18" Height="18" Fill="White" Margin="2,0,0,0" HorizontalAlignment="Left">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="SwitchKnob"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="Settings_Click">
                            <TextBlock Text="Положение и горячие клавиши"/>
                        </Button>
                        <Button Style="{StaticResource RowButton}" Click="Exit_Click">
                            <TextBlock Text="Закрыть остров" Foreground="#FF453A"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
